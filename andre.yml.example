# andre configuration template
# See: https://github.com/lthiagol/andre

# The packages folder: every subfolder is one package, named after its folder.
# Folders whose name starts with '.' are skipped (so .git is never a package).
# Relative paths start at this config folder; '~' is your home folder.
packages: ~/src/dotfiles

# Optional: where every package links. Default: your home folder.
# It must not be the packages folder or inside it.
# target: "~"

# Global settings that apply to every package
global:
  # Optional: link engine. 'native' (default) is built in and needs no GNU
  # stow binary. Set to 'stow' to shell out to GNU stow — required for
  # 'adopt' and 'dotfiles', and for regex ignore patterns.
  # engine: native

  # Optional: override the default theme (default, dracula, catppuccin-latte,
  # catppuccin-frappe, catppuccin-macchiato, catppuccin-mocha)
  # theme: default

  # Optional: icon set. 'nerd' (default) needs a Nerd Font in the terminal;
  # 'unicode' uses common Unicode symbols and needs no Nerd Font.
  # icons: nerd

  # Optional: patterns to ignore for every package (supports glob syntax).
  # A package can add its own .stow-local-ignore file.
  # ignore:
  #   - .git
  #   - .DS_Store
  #   - '*.swp'

  # Default stow options (can be overridden via TUI flags)
  stow:
    # Verbosity level: 0 (quiet), 1 (-v), 2 (-vv), 3 (-vvv)
    verbosity: 0

    # Enable dry-run mode (simulate without making changes)
    dry_run: false

    # Disable folding of newly-stowed directories into existing ones
    no_folding: false

    # Adopt existing files that conflict with stow
    adopt: false

    # Default action: stow, restow, delete, or simulate
    action: stow
