{
  "project": {
    "name": "andre",
    "description": "A TUI wrapper for GNU Stow — manage dotfiles visually: select groups and packages, toggle options, execute with live feedback, adopt existing files, unstow interactively, and edit the config in place.",
    "stack": [
      "rust"
    ],
    "platforms": [
      "macOS",
      "Linux"
    ],
    "created": "2026-07-23",
    "target_version": "1.0.0",
    "planning_status": "in-execution",
    "planning_phase": "charter"
  },
  "charter": {
    "goals": [
      "Visual, interactive management of GNU Stow dotfiles from the terminal.",
      "Cover the everyday flows: stow, guided adoption, interactive unstow, status, and config editing.",
      "Provide a headless --yolo mode for scripting and automation.",
      "Reach a stable v1.0 with a frozen, documented andre.yml config format."
    ],
    "non_goals": [
      "No GUI — terminal/TUI only.",
      "No cloud sync or remote/multi-machine management.",
      "Not a replacement for GNU Stow — a wrapper around it.",
      "No always-on automation daemon.",
      "No Windows support."
    ],
    "deferred": [
      "Post-1.0 feature ideas: more themes, richer config validation, adoption-UX expansions."
    ],
    "principles": [
      "No breaking andre.yml config changes after v1.0.",
      "Tests before code — every fix ships a regression test that would have caught it.",
      "Deep module separation: andre-core (logic, no TUI deps) vs andre (TUI binary).",
      "Unit tests must not depend on the real host environment (deterministic, hermetic).",
      "Each release documents breaking changes, features, and fixes in a changelog."
    ]
  },
